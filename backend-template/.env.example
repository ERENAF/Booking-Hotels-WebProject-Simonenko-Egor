# Переменные окружения проекта. Скопировать в .env (он в .gitignore) и заполнить.
# С лабы 2 здесь строка подключения к базе, с лабы 3 секрет JWT, с лабы 5 пароли для compose.

#Строка подключения к бд
#Файл booking.db создается после 1 запуска
DATABASE_URL = sqlite:///booking.db

#Flask
FLASK_APP = run.py
FLASK_DEBUG = 1
